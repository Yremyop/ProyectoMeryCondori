# InfinityFree sirve siempre desde htdocs: todo se redirige a public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Imágenes subidas (InfinityFree no permite el symlink de storage:link).
    RewriteCond %{REQUEST_URI} !^/storage/app/public/
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # El resto (incluido .env, vendor, storage…) nunca se sirve directo: pasa por public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/storage/app/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
